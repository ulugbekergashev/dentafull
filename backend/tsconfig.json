{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist"
    },
    "include": [
        "server.ts",
        "botManager.ts",
        "smsService.ts",
        "triggers.ts",
        "segments.ts",
        "segmentFields.ts",
        "segmentAggregates.ts",
        "savedSegments.ts",
        "ruleExtras.ts",
        "bot.ts",
        "seed.ts",
        "dmedService.ts",
        "aiService.ts",
        "ai/tools.ts",
        "ai/prompts.ts",
        "ai/reports.ts",
        "ai/guard.ts",
        "ai/log.ts",
        "ai/router.ts",
        "ai/context.ts",
        "ai/actions.ts",
        "ai/proactive.ts",
        "ai/keys.ts",
        "ai/speech.ts",
        "ai/translit.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test_*.ts",
        "debug_*.ts",
        "check_*.ts"
    ]
}