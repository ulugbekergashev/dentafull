# Database URL - PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/dentalcrm"

# JWT Secret - Use a strong random string
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Server Port (Railway will set this automatically)
PORT=3001

# Tashqi hamkorlarga (yuboraman.uz va h.k.) beriladigan endpoint manzili.
# Sozlamalar -> Lid integratsiyasi bo'limida shu manzil ko'rsatiladi.
PUBLIC_API_BASE_URL="https://dentafull-production.up.railway.app"

# ─── AI (backend'da qoladi, frontend'ga HECH QACHON uzatilmaydi) ──────────────
# Kamida bitta kalit kerak. Bir nechtasi berilsa, birinchisi limitga urilganda
# avtomatik keyingisiga o'tiladi.
#
# Gemini  — https://aistudio.google.com/apikey   (bepul tier, asosiy tavsiya)
# Groq    — https://console.groq.com/keys        (bepul, juda tez, arzon ishlar uchun)
# OpenRouter — https://openrouter.ai/keys        (zaxira, :free modellar bilan)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Qaysi provayder birinchi bo'lsin: gemini | groq | openrouter
# Berilmasa — kaliti bor birinchi provayder ishlatiladi.
AI_PROVIDER="gemini"

# Model nomlarini majburlash (ixtiyoriy — bo'sh qoldirsa mos standart ishlatiladi)
# Standartlar: GEMINI chat=gemini-3.5-flash, cheap=gemini-3.1-flash-lite
# (bepul tierda aynan shu ikkisi turadi; gemini-2.5-flash-lite YANGI
#  kalitlar uchun yopilgan — uni qaytarib qo'ymang, 404 beradi).
# GEMINI_MODEL_CHAT="gemini-3.5-flash"
# GROQ_MODEL_CHAT="llama-3.3-70b-versatile"

# ── Ovozni matnga aylantirish ────────────────────────────────────────────────
# Zanjir: klinikaning o'z kaliti -> GEMINI_API_KEY -> GROQ_API_KEY.
#
# GEMINI_STT_MODEL standarti — gemini-3.5-flash: BEPUL tierda va o'zbekchani
# Whisper'dan sezilarli yaxshi tushunadi.
#
# gemini-3.5-transcribe — maxsus STT modeli (85+ til, 1000 tagacha maxsus
# lug'at, so'zlovchini ajratish). Sifati yuqoriroq, lekin FAQAT PULLIK
# (~$0.005/daqiqa). Yoqishdan oldin `npx ts-node ai/evals/stt.ts` bilan
# o'lchab, farq to'lovga arziydimi — ko'rib oling.
# GEMINI_STT_MODEL="gemini-3.5-transcribe"
# STT_MODEL="whisper-large-v3"       # Groq zaxira yo'li

# Bitta AI so'rovi uchun maksimal kutish vaqti (ms)
AI_TIMEOUT_MS="60000"

# ── O'ylash budjeti (faqat Gemini) ───────────────────────────────────────────
# Gemini 3.x standart holda "o'ylab" javob beradi va Google o'ylash
# tokenlarini CHIQISH budjetiga qo'shib hisoblaydi. Shuning uchun javob
# o'rtada uzilib qolishi va sezilarli sekinlashishi mumkin.
#
# AI_REASONING_EFFORT: minimal | low | medium | high  (standart: low)
#   'none' ishlamaydi — 3.x modellarida o'ylashni butunlay o'chirib
#   bo'lmaydi. Tezlik kerak bo'lsa 'minimal', chuqurroq tahlil kerak
#   bo'lsa 'medium'. O'zgartirgandan keyin `npm run eval` bilan o'lchang.
# AI_REASONING_EFFORT="low"
#
# AI_THINK_ALLOWANCE: o'ylash uchun max_tokens ustiga qo'shiladigan zapas
# (standart: 1024). Javob budjeti chaqiruv joyida belgilanadi va shu
# zapas tufayli o'ylash uni yeb qo'ymaydi.
# AI_THINK_ALLOWANCE="1024"
