# Database URL - PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/dentalcrm"

# JWT Secret - Use a strong random string
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Server Port (Railway will set this automatically)
PORT=3001

# Tashqi hamkorlarga (yuboraman.uz va h.k.) beriladigan endpoint manzili.
# Sozlamalar -> Lid integratsiyasi bo'limida shu manzil ko'rsatiladi.
PUBLIC_API_BASE_URL="https://dentafull-production.up.railway.app"

# ─── AI (backend'da qoladi, frontend'ga HECH QACHON uzatilmaydi) ──────────────
# Kamida bitta kalit kerak. Bir nechtasi berilsa, birinchisi limitga urilganda
# avtomatik keyingisiga o'tiladi.
#
# Gemini  — https://aistudio.google.com/apikey   (bepul tier, asosiy tavsiya)
# Groq    — https://console.groq.com/keys        (bepul, juda tez, arzon ishlar uchun)
# OpenRouter — https://openrouter.ai/keys        (zaxira, :free modellar bilan)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Qaysi provayder birinchi bo'lsin: gemini | groq | openrouter
# Berilmasa — kaliti bor birinchi provayder ishlatiladi.
AI_PROVIDER="gemini"

# Model nomlarini majburlash (ixtiyoriy — bo'sh qoldirsa mos standart ishlatiladi)
# GEMINI_MODEL_CHAT="gemini-2.0-flash"
# GROQ_MODEL_CHAT="llama-3.3-70b-versatile"

# Bitta AI so'rovi uchun maksimal kutish vaqti (ms)
AI_TIMEOUT_MS="60000"
