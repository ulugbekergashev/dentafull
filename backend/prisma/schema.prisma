generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id               String            @id @default(uuid())
  firstName        String
  lastName         String
  specialty        String
  phone            String
  email            String?
  status           String
  username         String?           @unique
  password         String?
  clinicId         String
  telegramChatId   String?
  percentage       Float             @default(0)
  salaryType       String            @default("none") // 'none' | 'fixed' | 'fixed_kpi' | 'kpi'
  fixedSalary      Float             @default(0)
  color            String?
  secondaryPhone   String?
  startHour        Int?
  endHour          Int?
  appointments     Appointment[]
  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  installmentPlans InstallmentPlan[]
  patients         Patient[]
  expenses         Expense[]

  @@unique([clinicId, telegramChatId])
}

model Receptionist {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  phone     String
  username  String    @unique
  password  String
  status    String
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  expenses  Expense[]
}

model Patient {
  id               String             @id @default(uuid())
  firstName        String
  lastName         String
  phone            String
  dob              String
  lastVisit        String
  status           String
  gender           String
  medicalHistory   String
  clinicId         String
  telegramChatId   String?
  address          String?
  createdAt        DateTime           @default(now())
  secondaryPhone   String?
  avatarUrl        String?
  portraitUrl      String?
  balance          Float              @default(0)
  doctorId         String?
  pinfl            String?
  appointments     Appointment[]
  installmentPlans InstallmentPlan[]
  inventoryLogs    InventoryLog[]
  clinic           Clinic             @relation(fields: [clinicId], references: [id])
  doctor           Doctor?            @relation(fields: [doctorId], references: [id])
  diagnoses        PatientDiagnosis[]
  photos           PatientPhoto[]
  telegramLogs     TelegramLog[]
  teeth            ToothData[]
  transactions     Transaction[]
  visits           Visit[]

  @@unique([clinicId, telegramChatId])
  @@index([phone])
}

model ToothData {
  id         Int      @id @default(autoincrement())
  patientId  String
  number     Int
  conditions String
  notes      String?
  updatedAt  DateTime @updatedAt
  patient    Patient  @relation(fields: [patientId], references: [id])

  @@unique([patientId, number])
}

model PatientPhoto {
  id          String   @id @default(uuid())
  patientId   String
  url         String
  description String?
  category    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Appointment {
  id           String  @id @default(uuid())
  patientId    String
  patientName  String
  doctorId     String
  doctorName   String
  type         String
  date         String
  time         String
  duration     Int
  status       String
  notes        String?
  clinicId     String
  reminderSent Boolean @default(false)
  clinic       Clinic  @relation(fields: [clinicId], references: [id])
  doctor       Doctor  @relation(fields: [doctorId], references: [id])
  patient      Patient @relation(fields: [patientId], references: [id])
  review       Review?
  visits       Visit[]

  @@unique([patientId, date], name: "unique_patient_date")
  @@index([date])
  @@index([patientId])
}

model Visit {
  id            String               @id @default(uuid())
  patientId     String
  appointmentId String?
  date          String
  checkInTime   DateTime             @default(now())
  checkOutTime  DateTime?
  status        String               @default("Waiting")
  complaints    String?
  vitalSigns    String?
  notes         String?
  clinicId      String
  diagnoses     PatientDiagnosis[]
  transactions  Transaction[]
  procedures    TreatmentProcedure[]
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id])
  clinic        Clinic               @relation(fields: [clinicId], references: [id])
  patient       Patient              @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([date])
}

model TreatmentProcedure {
  id            String    @id @default(uuid())
  visitId       String
  procedureName String
  toothNumber   Int?
  toothSurface  String?
  status        String    @default("Planned")
  basePrice     Float
  discount      Float     @default(0)
  finalPrice    Float
  materialsUsed String?
  notes         String?
  duration      Int?
  doctorId      String
  doctorName    String
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  visit         Visit     @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@index([toothNumber])
}

model Transaction {
  id              String   @id @default(uuid())
  patientName     String
  date            String
  amount          Float
  type            String
  service         String
  status          String
  clinicId        String
  doctorId        String?
  doctorName      String?
  patientId       String?
  visitId         String?
  discountAmount  Float?   @default(0)
  discountPercent Float?   @default(0)
  createdAt       DateTime? @default(now())
  /// Pulni kim qabul qildi. Rollar har xil jadvalda (Receptionist/Doctor/Clinic admin)
  /// bo'lgani uchun FK emas — id va ism nusxasi saqlanadi.
  receivedById    String?
  receivedByName  String?
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  patient         Patient? @relation(fields: [patientId], references: [id])
  visit           Visit?   @relation(fields: [visitId], references: [id])
}

model Expense {
  id              String        @id @default(uuid())
  date            String
  amount          Float
  category        String
  title           String
  method          String?
  note            String?
  clinicId        String
  doctorId        String?
  receptionistId  String?
  labOrderId      String?       @unique
  inventoryItemId String?
  createdAt       DateTime      @default(now())
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  doctor          Doctor?       @relation(fields: [doctorId], references: [id])
  receptionist    Receptionist? @relation(fields: [receptionistId], references: [id])
  labOrder        LabOrder?     @relation(fields: [labOrderId], references: [id])

  @@index([clinicId])
  @@index([doctorId])
  @@index([receptionistId])
}

model Service {
  id         Int              @id @default(autoincrement())
  name       String
  price      Float
  duration   Int
  clinicId   String
  cost       Float            @default(0)
  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])
  clinic     Clinic           @relation(fields: [clinicId], references: [id])
}

model SubscriptionPlan {
  id         String   @id
  name       String
  price      Float
  maxDoctors Int
  features   String
  clinics    Clinic[]
}

model Clinic {
  id                      String             @id @default(uuid())
  name                    String
  adminName               String
  username                String             @unique
  password                String?
  phone                   String
  status                  String
  planId                  String
  subscriptionStartDate   String
  expiryDate              String
  monthlyRevenue          Float
  telegramChatId          String?
  botToken                String?
  subscriptionType        String             @default("Paid")
  smsBalance              Float              @default(0)
  smsLimit                Int                @default(0)
  smsUsedThisMonth        Int                @default(0)
  ownerPhone              String?
  facebookPageAccessToken String?
  facebookPageId          String?
  facebookPageName        String?
  facebookUserAccessToken String?
  customPrice             Float?
  endHour                 Int                @default(20)
  startHour               Int                @default(8)
  address                 String?
  email                   String?
  enableReceipts          Boolean            @default(false)
  notificationMode        String             @default("telegram_only")
  eskizEmail              String?
  eskizPassword           String?
  eskizToken              String?
  eskizTokenExpiry        DateTime?
  eskizNick               String?
  dmedEnabled             Boolean            @default(false)
  dmedApiKey              String?
  dmedApiSecret           String?
  dmedClinicId            String?
  dmedToken               String?
  dmedTokenExpiry         DateTime?
  prepaymentEnabled       Boolean            @default(false)
  prepaymentCardNumber    String?
  prepaymentAmount        Float?
  accessControl           String?
  /// Tashqi lid manbalari (yuboraman va h.k.) uchun kirish kaliti.
  /// POST /api/public/leads da X-API-Key sarlavhasi orqali klinika shu kalit bo'yicha topiladi.
  leadApiKey              String?            @unique
  leadApiKeyCreatedAt     DateTime?
  appointments            Appointment[]
  plan                    SubscriptionPlan   @relation(fields: [planId], references: [id])
  doctors                 Doctor[]
  installmentPlans        InstallmentPlan[]
  inventoryItems          InventoryItem[]
  leads                   Lead[]
  patients                Patient[]
  diagnoses               PatientDiagnosis[]
  receptionists           Receptionist[]
  services                Service[]
  serviceCategories       ServiceCategory[]
  telegramLogs            TelegramLog[]
  transactions            Transaction[]
  visits                  Visit[]
  salesAgentId            String?
  salesAgent              SalesAgent?        @relation(fields: [salesAgentId], references: [id])
  labTechnicians          LabTechnician[]
  labOrders               LabOrder[]
  expenses                Expense[]
  messageTemplates        MessageTemplate[]
  automationRules         AutomationRule[]
  cashRegisterDays        CashRegisterDay[]
  cashMovements           CashMovement[]
  cashAuditLogs           CashAuditLog[]
  /// Kuniga nechta kassa smenasi (1 yoki 2). Klinikaga qarab sozlanadi.
  cashShiftsPerDay        Int                @default(1)

  @@index([botToken])
}

/// Kassa smenasini yopish: sanalgan naqd/terminal/Click hisob bilan solishtiriladi.
/// Bir kunda bir nechta smena bo'lishi mumkin (klinika sozlamasiga qarab).
model CashRegisterDay {
  id            String    @id @default(uuid())
  clinicId      String
  date          String
  /// Smena raqami. Bitta smenali klinikada har doim 1.
  shift         Int       @default(1)
  shiftStart    String?
  shiftEnd      String?
  /// Smena boshidagi naqd qoldiq (oldingi yopilishdan ko'chib keladi)
  openingCash   Float     @default(0)
  /// Kassir haqiqatda sanagan naqd
  countedCash   Float
  /// Yopilgan daqiqadagi hisob bo'yicha naqd qoldiq (snapshot)
  expectedCash  Float
  /// countedCash − expectedCash (kam/ortiq)
  difference    Float     @default(0)
  /// Terminal Z-hisoboti bo'yicha summa (kiritilmasa null — solishtirilmaydi)
  countedCard   Float?
  expectedCard  Float?
  /// Click/Payme kabineti bo'yicha summa
  countedClick  Float?
  expectedClick Float?
  note          String?
  closedByName  String?
  closedByRole  String?
  closedAt      DateTime  @default(now())
  clinic        Clinic    @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, date, shift])
  @@index([clinicId])
}

/// Kassaga xizmat to'lovidan tashqari kirgan/chiqqan pul.
/// Xarajatdan (Expense) ataylab ajratilgan: inkassatsiya va qaytarish klinikaning
/// xarajati emas, shuning uchun sof foydadan ayirilmasligi kerak.
model CashMovement {
  id            String   @id @default(uuid())
  clinicId      String
  date          String
  /// 'Encashment' — kassadan olib ketildi (inkassatsiya)
  /// 'Refund'     — bemorga pul qaytarildi
  /// 'CashIn'     — kassaga pul solindi (masalan, qaytim uchun mayda pul)
  type          String
  amount        Float
  /// Qaysi usulda: naqd yashikka faqat 'Cash' ta'sir qiladi
  method        String   @default("Cash")
  note          String?
  patientId     String?
  transactionId String?
  createdByName String?
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([date])
}

/// Kassa yozuvlariga qilingan o'zgarishlar izi.
/// Ayniqsa kun yopilgandan keyin to'lov o'chirilishi/o'zgartirilishi qayd etiladi —
/// bu kassa dasturidagi eng klassik teshik.
model CashAuditLog {
  id         String   @id @default(uuid())
  clinicId   String
  /// Yozuv qaysi kassa kuniga tegishli
  date       String
  action     String
  entityType String
  entityId   String?
  summary    String
  /// Kun o'sha paytda yopilgan bo'lganmi
  afterClose Boolean  @default(false)
  byName     String?
  byRole     String?
  createdAt  DateTime @default(now())
  clinic     Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([date])
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  service   String?
  source    String?
  notes     String?
  /// Tashqi manbadan (yuboraman va h.k.) kelgan payload'ning asl nusxasi, JSON matn ko'rinishida.
  /// notes matnga aylantirilganda ma'lumot yo'qolishi mumkin — bu ustun zaxira sifatida saqlanadi.
  raw       String?
  /// Manzil va tug'ilgan sana lid bemorga aylantirilganda Patient'ga ko'chiriladi.
  address   String?
  dob       String?
  status    String   @default("New")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([status])
  @@index([clinicId, phone, createdAt])
}

model DemoRequest {
  id           String   @id @default(uuid())
  name         String
  clinicName   String?
  phone        String
  city         String?
  doctorsCount Int?
  source       String?
  status       String   @default("New")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PlatformSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @default(now())
}

model ICD10Code {
  code        String             @id
  name        String
  description String?
  category    String?
  diagnoses   PatientDiagnosis[]
}

model PatientDiagnosis {
  id        String    @id @default(uuid())
  patientId String
  code      String
  date      String
  notes     String?
  status    String
  clinicId  String
  visitId   String?
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  icd10     ICD10Code @relation(fields: [code], references: [code])
  patient   Patient   @relation(fields: [patientId], references: [id])
  visit     Visit?    @relation(fields: [visitId], references: [id])
}

model InventoryItem {
  id          String         @id @default(uuid())
  name        String
  unit        String
  quantity    Float          @default(0)
  minQuantity Float          @default(0)
  clinicId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  clinic      Clinic         @relation(fields: [clinicId], references: [id])
  logs        InventoryLog[]
}

model InventoryLog {
  id        String        @id @default(uuid())
  itemId    String
  change    Float
  type      String
  note      String?
  date      DateTime      @default(now())
  userName  String
  patientId String?
  cost      Float?
  item      InventoryItem @relation(fields: [itemId], references: [id])
  patient   Patient?      @relation(fields: [patientId], references: [id])

  @@index([itemId])
  @@index([patientId])
}

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String
  clinicId String
  services Service[]
  clinic   Clinic    @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, name])
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model TelegramLog {
  id        String   @id @default(uuid())
  clinicId  String
  patientId String?
  type      String
  status    String
  message   String?
  error     String?
  sentAt    DateTime @default(now())
  channel   String   @default("telegram")
  source    String   @default("manual")
  ruleId    String?
  refId     String?
  recipient String?
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  patient   Patient? @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([ruleId, refId])
}

model MessageTemplate {
  id               String           @id @default(uuid())
  clinicId         String
  name             String
  text             String
  eskizTemplateId  Int?             // Eskiz.uz'dagi shablon ID'si
  eskizStatus      String?          // Eskiz'dan qaytgan moderatsiya holati (masalan: moderation/confirmed/declined)
  eskizSubmittedAt DateTime?        // Oxirgi marta Eskiz'ga yuborilgan vaqt
  createdAt        DateTime         @default(now())
  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  rules            AutomationRule[]

  @@index([clinicId])
}

model AutomationRule {
  id          String          @id @default(uuid())
  clinicId    String
  name        String
  templateId  String
  trigger     String // 'before_appointment' | 'birthday' | 'no_show'
  hoursBefore Int?
  channel     String // 'sms' | 'telegram' | 'both'
  doctorId    String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  template    MessageTemplate @relation(fields: [templateId], references: [id])

  @@index([clinicId])
}

model InstallmentPlan {
  id          String            @id @default(uuid())
  patientId   String
  clinicId    String
  doctorId    String?
  service     String
  totalAmount Float
  totalPaid   Float             @default(0)
  startDate   String
  endDate     String
  status      String            @default("Active")
  createdAt   DateTime          @default(now())
  items       InstallmentItem[]
  clinic      Clinic            @relation(fields: [clinicId], references: [id])
  doctor      Doctor?           @relation(fields: [doctorId], references: [id])
  patient     Patient           @relation(fields: [patientId], references: [id])
}

model InstallmentItem {
  id            String          @id @default(uuid())
  planId        String
  expectedDate  String
  amount        Float
  status        String          @default("Pending")
  paidDate      String?
  transactionId String?
  plan          InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model SalesAgent {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  phone     String
  status    String   @default("Active") // Active, Blocked
  clinics   Clinic[]
  createdAt DateTime @default(now())
}

model LabTechnician {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  specialty String
  phone     String
  status    String     @default("Active")
  clinicId  String
  username  String?    @unique
  password  String?
  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  labOrders LabOrder[]

  @@index([clinicId])
}

model LabOrder {
  id              String        @id @default(uuid())
  patientId       String?
  patientName     String
  doctorId        String?
  doctorName      String
  technicianId    String
  technicianName  String
  clinicId        String
  orderType       String
  material        String?
  toothNumbers    String?
  notes           String?
  status          String        @default("Pending")
  priority        String        @default("Normal")
  orderedAt       DateTime      @default(now())
  deadline        String
  deliveredAt     DateTime?
  price           Float         @default(0)
  clinicianNotes  String?
  technicianNotes String?
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  technician      LabTechnician @relation(fields: [technicianId], references: [id])
  expense         Expense?

  @@index([clinicId])
  @@index([technicianId])
  @@index([status])
}

/// AI so'rovlari jurnali. Har bir chaqiruv shu yerga tushadi — savol, javob,
/// qaysi tool'lar ishlatilgani, token sarfi, kechikish va foydalanuvchi bahosi.
///
/// Clinic bilan RELATION ATAYLAB YO'Q. Ikki sabab: (1) SUPER_ADMIN so'rovlarida
/// clinicId bo'sh bo'ladi; (2) klinika o'chirilganda uning jurnali ham
/// yo'qolib ketmasligi kerak — sarf va sifat statistikasi tarixiy ma'lumot.
model AiLog {
  id             String   @id @default(uuid())
  clinicId       String?
  userId         String?
  userName       String?
  role           String?
  /// 'ask' | 'report' | 'chat' | 'insights' | 'advisor' | 'digest' | 'anomaly' | 'action'
  endpoint       String
  lang           String?
  question       String?
  reply          String?
  /// Chaqirilgan tool'lar, JSON matn ko'rinishida.
  toolCalls      String?
  provider       String?
  model          String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  rounds         Int?
  cached         Boolean  @default(false)
  /// Grounding tekshiruvi natijasi. false — javobdan tasdiqlanmagan raqam olib tashlangan.
  groundingOk    Boolean?
  groundingInfo  String?
  error          String?
  /// 1 = foydali, -1 = foydasiz. Etalon to'plamni to'ldirishning asosiy manbasi.
  rating         Int?
  ratingNote     String?
  conversationId String?
  createdAt      DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([endpoint])
  @@index([rating])
}

/// Saqlangan suhbat. Ilgari tarix faqat brauzer xotirasida edi va sahifa
/// yopilishi bilan yo'qolardi — foydalanuvchi ertasi kuni o'z savolini ham,
/// javobini ham topa olmasdi.
model AiConversation {
  id        String   @id @default(uuid())
  clinicId  String
  userId    String?
  title     String
  /// Eski almashinuvlar xulosasi — suhbat uzayganda tokenni tejash uchun.
  summary   String?
  /// [{ q, a, sources }] JSON matn ko'rinishida.
  messages  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, userId, updatedAt])
}
